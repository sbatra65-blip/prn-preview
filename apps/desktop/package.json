{
  "name": "labeldesk-desktop",
  "productName": "LabelDesk",
  "version": "1.0.0",
  "private": true,
  "description": "LabelDesk for Windows: label designer and PRN previewer",
  "author": "Infinite Solutions <sbatra65-blip@users.noreply.github.com>",
  "homepage": "https://labeldesk.app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.labeldesk.desktop",
    "productName": "LabelDesk",
    "copyright": "© 2026 Infinite Solutions, New Delhi",
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "artifactName": "LabelDesk-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "LabelDesk-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LabelDesk"
    }
  }
}
