{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prn-preview",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "labeldesk.app", "custom_domain": true },
    { "pattern": "www.labeldesk.app", "custom_domain": true },
    { "pattern": "labels.infinitesolutions.co.in", "custom_domain": true }
  ],
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "LEADS", "database_name": "pic2label-leads", "database_id": "00617217-1ac9-4e87-8ed4-00989ebf5d75" }
  ],
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } },
    { "name": "LEAD_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "DESIGN_LIMITER", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
